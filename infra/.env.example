# Copy to infra/.env (chmod 600) and fill in ONE of the two credential sets.
# infra/.env is git-ignored.  Never commit real credentials.

# Option A — access grant (recommended: one string from the Storj console)
STORJ_ACCESS_GRANT=

# Option B — satellite + API key + passphrase
#STORJ_SATELLITE=us1.storj.io:7777
#STORJ_API_KEY=
#STORJ_PASSPHRASE=

# Native library log level (error|warn|info|debug). Logs go to stderr only.
UPLINK_LOG_LEVEL=error
