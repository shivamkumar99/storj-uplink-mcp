# syntax=docker/dockerfile:1.7
# ---------------------------------------------------------------------------
# DEV-ONLY variant of infra/Dockerfile: builds the MCP against a LOCAL, not yet
# published, storj-uplink-nodejs tarball, compiling libuplink + the addon from
# source inside the image (UPLINK_INSTALL=source).  Used to validate a library
# branch end-to-end against the local storj-up network before it is released.
#
#   npm pack ../storj-uplink-nodejs --pack-destination infra/dev/pkg
#   docker build -f infra/dev/Dockerfile.lib-source \
#     --build-arg LIB_TARBALL=infra/dev/pkg/storj-uplink-nodejs-1.0.4.tgz \
#     -t storj-uplink-mcp:lib-dev .
#
# Builds natively for the host architecture (no prebuilt needed), so on
# Apple Silicon this is a linux/arm64 image.
# ---------------------------------------------------------------------------
ARG LIB_TARBALL=infra/dev/pkg/storj-uplink-nodejs-1.0.4.tgz

FROM golang:1.25-trixie@sha256:2c4c60ef415fbfa5e90300722293bef36c5e63fae17570ce18f580af933dbd73 AS go

# Docker Hardened Image dev variant: shell + apt, root, for the build only.
FROM dhi.io/node:22-debian13-dev@sha256:cb4828216aa2d1d964e657bce189277fb927f3049fbf35592a7105034847cec2 AS build
COPY --from=go /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:${PATH}" \
    UPLINK_INSTALL=source \
    UPLINK_LOG_LEVEL=error \
    NPM_CONFIG_UPDATE_NOTIFIER=false NPM_CONFIG_FUND=false NPM_CONFIG_AUDIT=false
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      make=4.4.1-2+dhi1 curl=8.14.1-2+deb13u5+dhi0 ca-certificates=20250419+dhi2 \
      python3=3.13.5-1 build-essential=12.12+dhi1 gzip=1.13-1+dhi1 \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g node-gyp
# The hardened dev image ships no which(1) and its apt repo has no package for
# it; storj-uplink-nodejs's Makefile probes tools with `which`, so provide a
# POSIX shim (build stage only — it never reaches the runtime image).
RUN mkdir -p /usr/local/bin \
 && printf '#!/bin/sh\nfor c in "$@"; do command -v "$c" || exit 1; done\n' > /usr/local/bin/which \
 && chmod +x /usr/local/bin/which
WORKDIR /app
COPY package.json package-lock.json ./
COPY scripts ./scripts
# --ignore-scripts: do not build the *published* library here; the local tarball below replaces it.
RUN --mount=type=cache,target=/root/.npm npm ci --ignore-scripts
# Replace the published library with the local tarball (compiled from source here;
# its install script runs make install with UPLINK_INSTALL=source).
ARG LIB_TARBALL
COPY ${LIB_TARBALL} /tmp/storj-uplink-nodejs.tgz
# --save so the image's lockfile references the tarball; otherwise npm prune below
# would treat it as extraneous and reinstall the published version.
RUN --mount=type=cache,target=/root/.npm npm install /tmp/storj-uplink-nodejs.tgz --save \
 && node -e "const l=require('storj-uplink-nodejs');console.log('library',l.VERSION,JSON.stringify(l.uplinkCVersion()))"
COPY tsconfig.json ./
COPY src ./src
COPY ui ./ui
RUN npm run build \
 && npm prune --omit=dev --ignore-scripts \
 && rm -rf src ui scripts tsconfig.json

FROM dhi.io/node:22-debian13@sha256:fb00a158fa6047167885c65db6b9802cf1f234794e81bb393d683fadaa683500
ENV NODE_ENV=production UPLINK_LOG_LEVEL=error HOME=/home/node
WORKDIR /app
COPY --from=build --chown=1000:1000 /app/package.json ./package.json
COPY --from=build --chown=1000:1000 /app/node_modules ./node_modules
COPY --from=build --chown=1000:1000 /app/dist ./dist
USER 1000:1000
CMD ["node", "dist/index.js"]
